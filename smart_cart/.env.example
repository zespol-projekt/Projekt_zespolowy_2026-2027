# Opcjonalnie w lokalnym trybie pracy: domyślnie aplikacja używa hosta Expo i portu 8787.
# Na telefonie podaj adres komputera w tej samej sieci, nie localhost.
# EXPO_PUBLIC_STORES_API_URL=http://ADRES_IP_KOMPUTERA:8787/v1/stores

# Serwer: dane z repozytorium, w katalogu obok smart_cart.
# Własna ścieżka może być względna wobec smart_cart lub absolutna.
# SMARTCART_DATA_DIR=../dane-sklepow
# SMARTCART_DATA_PORT=8787

# Supabase: wartości z panelu wspólnego projektu. Instrukcja: docs/supabase-setup.md.
# Skopiuj plik do .env.local i zastąp przykłady. Moduł auth będzie dodany w kolejnych punktach.
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UZUPELNIJ

# Adres tego samego projektu dla serwera danych (ochrona API w punkcie 5).
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Hasło SMTP wpisz wyłącznie w panelu Supabase, nie w zmiennych EXPO_PUBLIC_*.
# Klucze secret/service_role nie są kluczami aplikacji.
