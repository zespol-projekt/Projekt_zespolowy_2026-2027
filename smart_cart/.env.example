# Opcjonalnie w lokalnym trybie pracy: domyślnie aplikacja używa hosta Expo i portu 8787.
# Na telefonie podaj adres komputera w tej samej sieci, nie localhost.
# EXPO_PUBLIC_STORES_API_URL=http://ADRES_IP_KOMPUTERA:8787/v1/stores

# Serwer: dane z repozytorium, w katalogu obok smart_cart.
# Własna ścieżka może być względna wobec smart_cart lub absolutna.
# SMARTCART_DATA_DIR=../dane-sklepow
# SMARTCART_DATA_PORT=8787

