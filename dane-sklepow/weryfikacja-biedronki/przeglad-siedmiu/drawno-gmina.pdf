<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex,nofollow">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>404</title>
    <link rel="stylesheet" type="text/css" href="/adm/lib/perfect-scrollbar/css/perfect-scrollbar.css" />
    <link rel="stylesheet" type="text/css" href="/adm/lib/material-design-icons/css/material-design-iconic-font.min.css" />
    <link rel="stylesheet" href="/adm/css/app.css" type="text/css" />
</head>

<body class="be-splash-screen">
    <div class="be-wrapper be-error be-error-404">
        <div class="be-content">
            <div class="main-content container-fluid">
                <div class="error-container">
                    <div class="error-number">404</div>
                    <div class="error-description">Wybrana strona nie istnieje. Sprawdź podany adres.</div>
                    <div class="error-goback-text">Chcesz przejść do strony głównej?</div>
                    <div class="error-goback-button"><a class="btn btn-xl btn-primary" href="/">Strona główna</a></div>
                </div>
            </div>
        </div>
    </div>
    <script src="/adm/lib/jquery/jquery.min.js" type="text/javascript"></script>
    <script src="/adm/lib/perfect-scrollbar/js/perfect-scrollbar.min.js" type="text/javascript"></script>
    <script src="/adm/lib/bootstrap/dist/js/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="/adm/js/app.js" type="text/javascript"></script>
    <script type="text/javascript">
    $(document).ready(function() {
        //-initialize the javascript
        App.init();
    });
    </script>
</body>

</html>